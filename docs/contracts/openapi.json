{
  "components": {
    "schemas": {
      "ApiErrorDetail": {
        "additionalProperties": false,
        "description": "Structured, non-sensitive description of a single API error.",
        "properties": {
          "code": {
            "description": "Stable machine-readable error code.",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "description": "Optional structured, non-sensitive context.",
            "title": "Details",
            "type": "object"
          },
          "document_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Related document identifier when applicable.",
            "title": "Document Id"
          },
          "message": {
            "description": "Human-readable, non-sensitive error message.",
            "title": "Message",
            "type": "string"
          },
          "page_number": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Related 1-based page number when applicable.",
            "title": "Page Number"
          },
          "request_id": {
            "description": "Correlates the error with server logs.",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ApiErrorDetail",
        "type": "object"
      },
      "ApiErrorEnvelope": {
        "additionalProperties": false,
        "description": "Top-level wrapper returned for every error response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetail",
            "description": "The error payload."
          }
        },
        "required": [
          "error"
        ],
        "title": "ApiErrorEnvelope",
        "type": "object"
      },
      "CheckState": {
        "description": "Result of a single readiness dependency check.",
        "enum": [
          "pass",
          "fail",
          "not_configured"
        ],
        "title": "CheckState",
        "type": "string"
      },
      "DependencyCheck": {
        "additionalProperties": false,
        "description": "Outcome of one readiness dependency check.",
        "properties": {
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional non-sensitive detail about the check.",
            "title": "Message"
          },
          "name": {
            "description": "Stable identifier of the checked dependency.",
            "title": "Name",
            "type": "string"
          },
          "required": {
            "description": "Whether this check must pass for readiness.",
            "title": "Required",
            "type": "boolean"
          },
          "status": {
            "$ref": "#/components/schemas/CheckState",
            "description": "Result of the check."
          }
        },
        "required": [
          "name",
          "status",
          "required"
        ],
        "title": "DependencyCheck",
        "type": "object"
      },
      "LivenessResponse": {
        "additionalProperties": false,
        "description": "Response for the liveness probe.",
        "properties": {
          "app_name": {
            "description": "Configured application name.",
            "title": "App Name",
            "type": "string"
          },
          "request_id": {
            "description": "Correlates the response with server logs.",
            "title": "Request Id",
            "type": "string"
          },
          "service": {
            "const": "veridemand-api",
            "default": "veridemand-api",
            "description": "Service identifier.",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "description": "Always 'ok' when the process runs.",
            "title": "Status",
            "type": "string"
          },
          "timestamp": {
            "description": "Timezone-aware UTC time of the response.",
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "version": {
            "description": "Application version.",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "app_name",
          "version",
          "timestamp",
          "request_id"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "additionalProperties": false,
        "description": "Response for the readiness probe.",
        "properties": {
          "app_name": {
            "description": "Configured application name.",
            "title": "App Name",
            "type": "string"
          },
          "checks": {
            "description": "Individual dependency check results.",
            "items": {
              "$ref": "#/components/schemas/DependencyCheck"
            },
            "title": "Checks",
            "type": "array"
          },
          "request_id": {
            "description": "Correlates the response with server logs.",
            "title": "Request Id",
            "type": "string"
          },
          "service": {
            "const": "veridemand-api",
            "default": "veridemand-api",
            "description": "Service identifier.",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "description": "Aggregate readiness state derived from the checks.",
            "enum": [
              "ready",
              "degraded",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          },
          "timestamp": {
            "description": "Timezone-aware UTC time of the response.",
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "version": {
            "description": "Application version.",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "app_name",
          "version",
          "timestamp",
          "request_id",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Runtime-only document extraction platform API.",
    "title": "VeriDemand API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "description": "Return 200 while the process is running. No expensive work is performed.",
        "operationId": "health_live",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Report readiness for Phase 0 required dependencies.\n\nReturns 200 when all required checks pass and 503 when any required check\nfails. Optional future dependencies never make the service unready.",
        "operationId": "health_ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description": "Service is not ready."
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    }
  }
}
