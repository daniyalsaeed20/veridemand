{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veridemand.local/remediation/page-annotation.schema.json",
  "title": "PageAnnotation",
  "description": "EVALUATION SCHEMA — NOT YET PRODUCTION CONTRACT. Private page annotation for extraction acceptance review.",
  "type": "object",
  "required": [
    "schema_label",
    "page_id",
    "case_alias",
    "doc_alias",
    "page_number",
    "annotation_status",
    "machine_transcript",
    "expected_transcript",
    "questions",
    "revision"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_label": {
      "type": "string",
      "const": "EVALUATION SCHEMA — NOT YET PRODUCTION CONTRACT"
    },
    "page_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_\\-]+$" },
    "case_alias": { "type": "string" },
    "doc_alias": { "type": "string" },
    "page_number": { "type": "integer", "minimum": 1 },
    "annotation_status": {
      "type": "string",
      "enum": [
        "machine_prefill",
        "in_review",
        "human_reviewed",
        "needs_second_review",
        "unreadable"
      ]
    },
    "ground_truth_ready": { "type": "boolean" },
    "prefill_label": { "type": "string" },
    "machine_transcript": { "type": "string" },
    "expected_transcript": { "type": "string" },
    "machine_reading_order": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "expected_reading_order": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "reading_order_confirmed": { "type": "boolean" },
    "order_issue_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "cross_column_error",
          "cross_row_error",
          "header_body_merge",
          "footer_body_merge",
          "table_cell_order_error",
          "form_label_value_mismatch"
        ]
      }
    },
    "expected_boxes": {
      "type": "array",
      "items": { "$ref": "#/$defs/expectedBox" }
    },
    "critical_fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/criticalField" }
    },
    "questions": { "$ref": "#/$defs/questions" },
    "notes": { "type": "string" },
    "reviewer": { "type": "string" },
    "review_date": { "type": "string" },
    "updated_at": { "type": "string" },
    "revision": { "type": "integer", "minimum": 0 },
    "etag": { "type": "string" },
    "machine_prefill_ref": { "type": "string" },
    "challenges": {
      "type": "array",
      "items": { "type": "string" }
    },
    "geometry_review_complete": { "type": "boolean" },
    "text_review_complete": { "type": "boolean" },
    "order_review_complete": { "type": "boolean" }
  },
  "$defs": {
    "answer": {
      "type": "string",
      "enum": ["Yes", "No", "Partly", "Not applicable", "Unsure", ""]
    },
    "questions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text_matches_visible_page": { "$ref": "#/$defs/answer" },
        "words_missing": { "$ref": "#/$defs/answer" },
        "extra_words_present": { "$ref": "#/$defs/answer" },
        "reading_order_correct": { "$ref": "#/$defs/answer" },
        "boxes_enclose_correct_words": { "$ref": "#/$defs/answer" },
        "native_text_layer_trustworthy": { "$ref": "#/$defs/answer" },
        "fresh_ocr_required": { "$ref": "#/$defs/answer" },
        "page_unreadable": { "$ref": "#/$defs/answer" },
        "critical_values_exact": { "$ref": "#/$defs/answer" }
      }
    },
    "polygon": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "number" }
      }
    },
    "expectedBox": {
      "type": "object",
      "required": ["box_id", "granularity", "polygon"],
      "properties": {
        "box_id": { "type": "string" },
        "granularity": {
          "type": "string",
          "enum": ["region", "line", "word", "symbol"]
        },
        "polygon": { "$ref": "#/$defs/polygon" },
        "associated_text": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["confirmed", "wrong", "text_ok_box_wrong", "draft"]
        }
      }
    },
    "criticalField": {
      "type": "object",
      "required": ["field_id", "field_type", "expected"],
      "properties": {
        "field_id": { "type": "string" },
        "field_type": { "type": "string" },
        "friendly_name": { "type": "string" },
        "expected": { "type": "string" },
        "machine_reading": { "type": "string" },
        "corrupt_embedded_candidate": { "type": "string" },
        "status": {
          "type": "string",
          "enum": [
            "USER_CONFIRMED_ANCHOR",
            "exact",
            "incorrect",
            "unreadable",
            "unresolved"
          ]
        },
        "layer": { "type": "string" },
        "machine_box_id": { "type": ["string", "null"] },
        "expected_box_id": { "type": ["string", "null"] },
        "notes": { "type": "string" },
        "requires_text_review": { "type": "boolean" },
        "requires_layer_review": { "type": "boolean" },
        "requires_geometry_review": { "type": "boolean" }
      }
    }
  }
}
