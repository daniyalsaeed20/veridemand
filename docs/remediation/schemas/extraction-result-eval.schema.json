{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veridemand.local/remediation/extraction-result-eval.schema.json",
  "title": "ExtractionResultEval",
  "description": "EVALUATION SCHEMA — NOT YET PRODUCTION CONTRACT. Vendor-neutral extraction result for acceptance scoring only.",
  "type": "object",
  "required": ["schema_label", "document", "engine"],
  "additionalProperties": false,
  "properties": {
    "schema_label": {
      "type": "string",
      "const": "EVALUATION SCHEMA — NOT YET PRODUCTION CONTRACT"
    },
    "document": {
      "type": "object",
      "required": ["document_id", "safe_alias", "pages"],
      "additionalProperties": false,
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "safe_alias": { "type": "string", "minLength": 1 },
        "original_file_alias": { "type": "string" },
        "canonical_file_alias": { "type": "string" },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/page" }
        }
      }
    },
    "engine": {
      "type": "object",
      "required": ["name", "version", "configuration"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "configuration": {
          "type": "object",
          "description": "Opaque but required processing configuration map",
          "additionalProperties": true
        }
      }
    },
    "quality_flags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "polygon": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "number" }
      }
    },
    "page": {
      "type": "object",
      "required": [
        "page_number",
        "page_width",
        "page_height",
        "rotation",
        "input_layer",
        "canonical_status",
        "regions"
      ],
      "additionalProperties": false,
      "properties": {
        "page_number": { "type": "integer", "minimum": 1 },
        "page_width": { "type": "number", "exclusiveMinimum": 0 },
        "page_height": { "type": "number", "exclusiveMinimum": 0 },
        "rotation": { "type": "integer" },
        "render_width": { "type": ["integer", "null"] },
        "render_height": { "type": ["integer", "null"] },
        "input_layer": {
          "type": "string",
          "enum": [
            "native_pdf_text",
            "embedded_ocr",
            "fresh_ocr",
            "manual_correction",
            "model_assisted_review"
          ]
        },
        "canonical_status": {
          "type": "string",
          "enum": ["canonical", "rejected", "alternative"]
        },
        "selection_reason": { "type": "string" },
        "outcome": {
          "type": "string",
          "enum": [
            "faithful_canonical",
            "extracted_with_warnings",
            "ambiguous_with_alternatives",
            "unreadable_review_required",
            "unsupported"
          ]
        },
        "processing_transforms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "quality_flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "alternative_readings": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "regions": {
          "type": "array",
          "items": { "$ref": "#/$defs/region" }
        }
      }
    },
    "region": {
      "type": "object",
      "required": ["region_id", "reading_order", "lines"],
      "additionalProperties": false,
      "properties": {
        "region_id": { "type": "string" },
        "region_type": {
          "type": "string",
          "enum": [
            "page",
            "paragraph",
            "column",
            "table",
            "form",
            "header",
            "footer",
            "diagram",
            "other"
          ]
        },
        "polygon": { "$ref": "#/$defs/polygon" },
        "reading_order": { "type": "integer", "minimum": 0 },
        "lines": {
          "type": "array",
          "items": { "$ref": "#/$defs/line" }
        }
      }
    },
    "line": {
      "type": "object",
      "required": ["line_id", "text", "reading_order"],
      "additionalProperties": false,
      "properties": {
        "line_id": { "type": "string" },
        "text": { "type": "string" },
        "confidence": { "type": ["number", "null"] },
        "polygon": { "$ref": "#/$defs/polygon" },
        "reading_order": { "type": "integer", "minimum": 0 },
        "words": {
          "type": "array",
          "items": { "$ref": "#/$defs/word" }
        }
      }
    },
    "word": {
      "type": "object",
      "required": ["word_id", "text", "reading_order"],
      "additionalProperties": false,
      "properties": {
        "word_id": { "type": "string" },
        "text": { "type": "string" },
        "confidence": { "type": ["number", "null"] },
        "polygon": { "$ref": "#/$defs/polygon" },
        "reading_order": { "type": "integer", "minimum": 0 },
        "derived": {
          "type": "boolean",
          "description": "True when word was split from a line box and is not engine-native geometry"
        },
        "symbols": {
          "type": "array",
          "items": { "$ref": "#/$defs/symbol" }
        }
      }
    },
    "symbol": {
      "type": "object",
      "required": ["symbol_id", "text", "reading_order"],
      "additionalProperties": false,
      "properties": {
        "symbol_id": { "type": "string" },
        "text": { "type": "string", "minLength": 1, "maxLength": 8 },
        "confidence": { "type": ["number", "null"] },
        "polygon": { "$ref": "#/$defs/polygon" },
        "reading_order": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
