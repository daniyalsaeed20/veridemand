{
  "schema_version": "phase05-firm-gold-review.v1",
  "description": "Phase 5 firm gold lawyer-review pack schema (no case data).",
  "implementation_commit_required": "cab86da303ae4340729d56a68194b92c90c4dab1",
  "allowed_decisions": [
    "APPROVE",
    "CORRECT",
    "REJECT_FALSE_POSITIVE",
    "NOT_PRESENT",
    "UNREADABLE",
    "REQUIRES_LEGAL_JUDGMENT",
    "DUPLICATE",
    "WRONG_FACT_TYPE",
    "WRONG_SOURCE",
    "MISSING_EXPECTED_FACT"
  ],
  "allowed_confidence": ["Clear", "Unclear", "Unreadable"],
  "allowed_approval_status": [
    "Approved",
    "Approved with listed unresolved items",
    "Not approved"
  ],
  "critical_fact_types": [
    "client.name",
    "client.dob",
    "insured.name",
    "insurer.name",
    "claim.number",
    "policy.number",
    "collision.date",
    "collision.location",
    "collision.report_number",
    "medical.diagnosis",
    "damages.specials_claimed",
    "correspondence.offer_deadline",
    "client.pronouns"
  ],
  "row_fields": [
    "review_row_id",
    "fact_or_issue_id",
    "conflict_group_id",
    "fact_type",
    "criticality",
    "document_alias",
    "document_category",
    "authority_state",
    "page_number",
    "source_span_ids",
    "raw_value",
    "normalized_value",
    "display_value",
    "system_status",
    "classification_ambiguous",
    "source_method",
    "parser_id",
    "calculation_input_ids",
    "system_warning",
    "row_kind",
    "sheet_hint",
    "reviewer_decision",
    "reviewer_approved_value",
    "reviewer_approved_normalized",
    "reviewer_approved_fact_type",
    "correct_source_alias",
    "correct_source_page",
    "reviewer_confidence",
    "reviewer_comments",
    "review_date",
    "reviewer_initials"
  ],
  "rules": {
    "blank_decision_is_not_approval": true,
    "correct_requires_value": true,
    "approved_requires_signoff_and_resolved_critical": true,
    "single_reviewer_sufficient": true
  }
}
