{
  "name": "veridemand",
  "version": "0.1.0",
  "private": true,
  "description": "VeriDemand document-extraction platform monorepo (Phase 4 complete).",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:backend": "uv run uvicorn backend.app.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:frontend": "pnpm -C frontend dev",
    "contracts:generate": "uv run python scripts/generate_contracts.py && pnpm -C frontend generate:contracts",
    "contracts:check": "uv run python scripts/check_contracts.py",
    "format": "uv run ruff format backend scripts model_development && pnpm -C frontend format",
    "format:check": "uv run ruff format --check backend scripts model_development && pnpm -C frontend format:check",
    "lint": "uv run ruff check backend scripts model_development && pnpm -C frontend lint",
    "typecheck": "uv run mypy backend scripts && pnpm -C frontend typecheck",
    "test": "uv run pytest && pnpm -C frontend test",
    "test:e2e": "pnpm -C frontend test:e2e",
    "build": "pnpm -C frontend build",
    "check:legacy": "uv run python scripts/check_no_legacy_scope.py",
    "check:private": "uv run python scripts/check_no_private_corpus.py",
    "check:wasm": "uv run python scripts/verify_pdfjs_wasm.py --sync --clean",
    "smoke:corpus": "uv run python scripts/run_smoke_corpus.py --mode page-by-page",
    "smoke:corpus:whole": "uv run python scripts/run_smoke_corpus.py --mode whole-document",
    "smoke:corpus:page": "uv run python scripts/run_smoke_corpus.py --mode page-by-page",
    "smoke:corpus:test-id": "uv run python scripts/run_smoke_corpus.py --mode page-by-page --test-id",
    "smoke:corpus:validate": "uv run python scripts/run_smoke_corpus.py --validate-only",
    "smoke:corpus:critical": "uv run python scripts/run_smoke_corpus.py --mode page-by-page --critical-subset",
    "smoke:corpus:phase4": "uv run python scripts/run_smoke_corpus.py --mode page-by-page --phase4-subset",
    "models:ocr:bootstrap": "uv run --group ocr python scripts/bootstrap_ocr_models.py",
    "models:ocr:verify": "uv run --group ocr python scripts/verify_ocr_runtime.py",
    "models:handwriting:fixture": "uv run --group model-dev python scripts/generate_handwriting_classifier_fixture.py",
    "models:handwriting:verify": "uv run python scripts/verify_handwriting_classifier.py",
    "models:handwriting:train": "uv run --group model-dev python scripts/phase5/train_handwriting_classifier.py train-export",
    "models:handwriting:manifest": "uv run --group model-dev python scripts/phase5/train_handwriting_classifier.py build-manifest",
    "phase5:model-data:asap:prepare": "uv run --group model-dev python scripts/phase5/train_handwriting_classifier.py prepare-asap",
    "phase5:crops:init": "uv run python scripts/phase5_dataset_cli.py init",
    "phase5:crops:register": "uv run python scripts/phase5_dataset_cli.py register-sources",
    "phase5:crops:export": "uv run python scripts/phase5_dataset_cli.py export",
    "phase5:crops:export-all": "uv run python scripts/phase5_dataset_cli.py export-all",
    "phase5:crops:import-manual": "uv run python scripts/phase5_dataset_cli.py import-manual",
    "phase5:crops:verify": "uv run python scripts/phase5_dataset_cli.py verify-crops",
    "phase5:crops:populate-evidence": "uv run --group ocr python scripts/phase5/populate_private_evidence.py",
    "phase5:labels:serve": "uv run python scripts/phase5/labeler_server.py",
    "phase5:labels:resolve": "uv run python scripts/phase5_dataset_cli.py resolve",
    "phase5:labels:queue": "uv run python scripts/phase5_dataset_cli.py queue",
    "phase5:labels:prototype-queue": "uv run python scripts/phase5_dataset_cli.py prototype-queue",
    "phase5:labels:prototype-report": "uv run python scripts/phase5_dataset_cli.py prototype-report",
    "phase5:labels:pilot": "uv run python scripts/phase5_dataset_cli.py pilot-build --write-aggregate docs/evaluation/phase-5-annotation-pilot.md",
    "phase5:labels:pilot-report": "uv run python scripts/phase5_dataset_cli.py pilot-report",
    "phase5:labels:adjudication": "uv run python scripts/phase5_dataset_cli.py adjudication-queue",
    "phase5:coverage:build": "uv run python scripts/phase5_dataset_cli.py coverage-build",
    "phase5:coverage:serve": "uv run python scripts/phase5/coverage_server.py",
    "phase5:coverage:verify": "uv run python scripts/phase5_dataset_cli.py coverage-verify",
    "phase5:coverage:report": "uv run python scripts/phase5_dataset_cli.py coverage-report",
    "phase5:coverage:worklist": "uv run python scripts/phase5_dataset_cli.py coverage-worklist",
    "phase5:dataset:backup": "uv run python scripts/phase5_dataset_cli.py backup",
    "phase5:handwriting-seeds:queue": "uv run python scripts/phase5_dataset_cli.py handwriting-seeds-queue",
    "phase5:handwriting-seeds:serve": "uv run python scripts/phase5/handwriting_seed_server.py",
    "phase5:handwriting-seeds:verify": "uv run python scripts/phase5_dataset_cli.py handwriting-seeds-verify",
    "phase5:handwriting-seeds:resolve": "uv run python scripts/phase5_dataset_cli.py handwriting-seeds-resolve",
    "phase5:handwriting-seeds:report": "uv run python scripts/phase5_dataset_cli.py handwriting-seeds-report",
    "phase5:detector-corpus:build": "uv run --group ocr python scripts/phase5/build_detector_first_corpus.py build",
    "phase5:detector-corpus:compare": "uv run --group ocr python scripts/phase5/build_detector_first_corpus.py compare",
    "phase5:detector-corpus:coverage": "uv run python scripts/phase5/build_detector_first_corpus.py coverage",
    "phase5:dataset:dedupe-sources": "uv run python scripts/phase5_dataset_cli.py dedupe-sources",
    "phase5:dataset:provenance": "uv run python scripts/phase5_dataset_cli.py provenance-audit --write-aggregate docs/evaluation/phase-5-provenance-audit.md",
    "phase5:dataset:block-coverage": "uv run python scripts/phase5_dataset_cli.py block-coverage",
    "phase5:dataset:duplicates": "uv run python scripts/phase5_dataset_cli.py duplicates",
    "phase5:dataset:split": "uv run python scripts/phase5_dataset_cli.py split",
    "phase5:dataset:freeze-heldout": "uv run python scripts/phase5_dataset_cli.py freeze-heldout",
    "phase5:dataset:verify": "uv run python scripts/phase5_dataset_cli.py verify",
    "phase5:dataset:report": "uv run python scripts/phase5_dataset_cli.py report --write-aggregate docs/evaluation/phase-5-dataset-readiness.md",
    "test:ocr": "uv run --group ocr pytest backend/tests -k ocr",
    "test:ocr:integration": "uv run --group ocr pytest backend/tests/test_ocr_integration.py -v",
    "evaluate:ocr": "uv run --group ocr python scripts/evaluate_printed_ocr.py",
    "verify:visual-runtime": "uv run --group ocr python scripts/verify_ocr_runtime.py",
    "verify:windows-dev-runtime": "uv run python scripts/verify_windows_dev_runtime.py",
    "diagnose:mkldnn": "uv run --group ocr python scripts/diagnose_mkldnn_windows.py",
    "check": "uv run python scripts/check_all.py"
  },
  "devDependencies": {
    "concurrently": "9.2.0"
  }
}
