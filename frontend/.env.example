VITE_API_BASE_URL=http://127.0.0.1:8000

# Diagnostic-only: force PDF.js to download the full canonical PDF
# (disableRange + disableStream + disableAutoFetch). Keep false for normal use.
# VITE_PDFJS_ISOLATION_MODE=false

# Optional devicePixelRatio cap while diagnosing blank pages (e.g. 1).
# VITE_PDFJS_MAX_DPR=

# DEV-only synthetic alignment overlay (coordinate test). Off by default.
# VITE_SHOW_ALIGNMENT_OVERLAY=false
