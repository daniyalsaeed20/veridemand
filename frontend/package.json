{
  "name": "veridemand-frontend",
  "private": true,
  "version": "0.0.0-dev",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "schemas:generate": "node ../scripts/generate-zod.mjs",
    "schemas:check": "node ../scripts/check-contracts.mjs"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.25.76",
    "zustand": "5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.31.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "json-schema-to-zod": "2.6.1",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vite": "7.0.5",
    "vitest": "3.2.4"
  }
}
