APP_ENV=development
APP_NAME=VeriDemand
APP_VERSION=0.1.0
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

TEMP_ROOT=./temp
SESSION_TTL_SECONDS=7200
EXPORT_TTL_SECONDS=1800

SESSION_CLEANUP_INTERVAL_SECONDS=60
SESSION_EXPIRING_WARNING_SECONDS=300

MAX_FILES_PER_SESSION=25
MAX_PAGES_PER_SESSION=500
MAX_SINGLE_FILE_BYTES=104857600
MAX_SESSION_BYTES=524288000

UPLOAD_CHUNK_BYTES=1048576
MAX_FILENAME_LENGTH=255
MAX_IMAGE_PIXELS=100000000

MAX_DOCX_ARCHIVE_ENTRIES=10000
MAX_DOCX_UNCOMPRESSED_BYTES=268435456
MAX_DOCX_ENTRY_BYTES=67108864
MAX_DOCX_COMPRESSION_RATIO=100

SSE_HEARTBEAT_SECONDS=15
SSE_REPLAY_MAX_EVENTS=500
SSE_SUBSCRIBER_QUEUE_SIZE=100
MAX_SSE_CONNECTIONS_PER_SESSION=3

QUEUE_ADMISSION_WORKERS=1
# Test-only: hold canonicalisation for N seconds so E2E can observe the
# queued/canonicalising states and exercise cancellation. Keep 0 in production.
QUEUE_ADMISSION_TEST_DELAY_SECONDS=0

LIBREOFFICE_EXECUTABLE=
LIBREOFFICE_TIMEOUT_SECONDS=120
LIBREOFFICE_TERMINATION_GRACE_SECONDS=5

CANONICALISATION_WORKERS=1
CANONICALISATION_THREAD_WORKERS=1

TXT_PAGE_SIZE=LETTER
TXT_MARGIN_POINTS=54
TXT_FONT_SIZE_POINTS=10
TXT_LEADING_POINTS=12
TXT_TAB_SIZE=4

IMAGE_CANONICAL_DPI=96
MAX_CANONICAL_PAGE_POINTS=14400

CANONICAL_FILE_CACHE_CONTROL=no-store
CANONICAL_PAGE_DIMENSION_TOLERANCE_POINTS=0.5

VIEWER_MIN_SCALE=0.25
VIEWER_MAX_SCALE=4.0
VIEWER_SCALE_STEP=0.25

HEAVY_DOCUMENT_WORKERS=1
RENDER_CONCURRENCY=2
OCR_CONCURRENCY=1

PDF_RENDER_DPI=300
PDF_RENDER_RETRY_DPI=400

NATIVE_TRUST_THRESHOLD=0.75
DOCUMENT_VISUAL_AUTHORITY_FAILURE_RATIO=0.30

PRINTED_THRESHOLD=0.85
HANDWRITING_THRESHOLD=0.70
UNCERTAIN_TO_LLM=true

PADDLE_DEVICE=cpu
PADDLE_OCR_MODEL=PP-OCRv5_mobile
PADDLE_LAYOUT_ENABLED=true

HANDWRITING_CLASSIFIER_PATH=./models/handwriting_classifier/model.onnx

OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3
OPENAI_CONCURRENCY=1
OPENAI_MAX_REGIONS_PER_REQUEST=12
OPENAI_MAX_REGIONS_PER_DOCUMENT=500

LOG_LEVEL=INFO
LOG_DOCUMENT_TEXT=false
