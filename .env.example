APP_ENV=development
APP_NAME=VeriDemand
APP_VERSION=0.1.0
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

TEMP_ROOT=./temp
SESSION_TTL_SECONDS=7200
EXPORT_TTL_SECONDS=1800

SESSION_CLEANUP_INTERVAL_SECONDS=60
SESSION_EXPIRING_WARNING_SECONDS=300

MAX_FILES_PER_SESSION=25
MAX_PAGES_PER_SESSION=500
MAX_SINGLE_FILE_BYTES=104857600
MAX_SESSION_BYTES=524288000

UPLOAD_CHUNK_BYTES=1048576
MAX_FILENAME_LENGTH=255
MAX_IMAGE_PIXELS=100000000

MAX_DOCX_ARCHIVE_ENTRIES=10000
MAX_DOCX_UNCOMPRESSED_BYTES=268435456
MAX_DOCX_ENTRY_BYTES=67108864
MAX_DOCX_COMPRESSION_RATIO=100

SSE_HEARTBEAT_SECONDS=15
SSE_REPLAY_MAX_EVENTS=500
SSE_SUBSCRIBER_QUEUE_SIZE=100
MAX_SSE_CONNECTIONS_PER_SESSION=3

QUEUE_ADMISSION_WORKERS=1
# Test-only: hold canonicalisation for N seconds so E2E can observe the
# queued/canonicalising states and exercise cancellation. Keep 0 in production.
QUEUE_ADMISSION_TEST_DELAY_SECONDS=0

LIBREOFFICE_EXECUTABLE=
LIBREOFFICE_TIMEOUT_SECONDS=120
LIBREOFFICE_TERMINATION_GRACE_SECONDS=5

CANONICALISATION_WORKERS=1
CANONICALISATION_THREAD_WORKERS=1

TXT_PAGE_SIZE=LETTER
TXT_MARGIN_POINTS=54
TXT_FONT_SIZE_POINTS=10
TXT_LEADING_POINTS=12
TXT_TAB_SIZE=4

IMAGE_CANONICAL_DPI=96
MAX_CANONICAL_PAGE_POINTS=14400

CANONICAL_FILE_CACHE_CONTROL=no-store
CANONICAL_PAGE_DIMENSION_TOLERANCE_POINTS=0.5

VIEWER_MIN_SCALE=0.25
VIEWER_MAX_SCALE=4.0
VIEWER_SCALE_STEP=0.25

HEAVY_DOCUMENT_WORKERS=1
RENDER_CONCURRENCY=1
OCR_CONCURRENCY=1

NATIVE_TRUST_THRESHOLD=0.75
DOCUMENT_VISUAL_AUTHORITY_FAILURE_RATIO=0.30

NATIVE_EXTRACTION_TIMEOUT_SECONDS=600
NATIVE_TERMINATION_GRACE_SECONDS=5
NATIVE_WORKERS=1
NATIVE_DEDUPE_TOLERANCE_POINTS=1.0
NATIVE_COORDINATE_TOLERANCE_POINTS=0.5
NATIVE_MIN_CHARACTERS=8
NATIVE_MAX_CHARACTERS_PER_PAGE=250000
NATIVE_MAX_WORDS_PER_PAGE=100000
NATIVE_MAX_REPLACEMENT_RATIO=0.005
NATIVE_MAX_CONTROL_RATIO=0.002
NATIVE_MAX_PRIVATE_USE_RATIO=0.005
NATIVE_MAX_UNASSIGNED_RATIO=0.005
NATIVE_MAX_CID_TOKEN_RATIO=0.05
NATIVE_MAX_INVALID_GEOMETRY_RATIO=0.01
NATIVE_MAX_OUT_OF_BOUNDS_RATIO=0.01
NATIVE_MAX_DUPLICATE_RATIO=0.20
NATIVE_MAX_SYMBOL_ONLY_WORD_RATIO=0.40
NATIVE_MAX_SINGLE_CHARACTER_WORD_RATIO=0.75
NATIVE_IMAGE_DOMINANT_AREA_RATIO=0.80
NATIVE_DOCUMENT_MIN_FAILED_PAGES=2
NATIVE_TRUST_POLICY_VERSION=phase3-v1
# Test-only: hold native extraction for N seconds so E2E can cancel mid-worker.
NATIVE_EXTRACTION_TEST_DELAY_SECONDS=0

PRINTED_THRESHOLD=0.85
HANDWRITING_THRESHOLD=0.70
UNCERTAIN_TO_LLM=true

# Phase 4 — printed OCR / visual processing
OCR_ENABLED=true
# Acceptance / test only — fail visual after native, before OCR. Never enable in production.
OCR_INJECT_VISUAL_FAILURE=false
OCR_DEVICE=cpu
OCR_ENGINE=paddle_static
OCR_DETECTION_MODEL_NAME=PP-OCRv5_mobile_det
OCR_RECOGNITION_MODEL_NAME=PP-OCRv5_mobile_rec
MODEL_ROOT=./.models
OCR_MODEL_ROOT=./.models/paddleocr
OCR_WORKERS=1
OCR_CPU_THREADS=4
OCR_RECOGNITION_BATCH_SIZE=1
OCR_RENDER_DPI=200
OCR_VISIBILITY_PROBE_DPI=96
OCR_MIN_EFFECTIVE_DPI=120
OCR_MAX_RENDER_PIXELS=40000000
OCR_MAX_RENDER_SIDE_PIXELS=6000
OCR_TEXT_DET_LIMIT_SIDE_LEN=1600
OCR_TEXT_DET_LIMIT_TYPE=max
OCR_TEXT_DET_THRESH=0.30
OCR_TEXT_DET_BOX_THRESH=0.60
OCR_TEXT_DET_UNCLIP_RATIO=1.50
OCR_MIN_RECOGNITION_SCORE=0.30
OCR_LOW_CONFIDENCE_SCORE=0.75
OCR_ENABLE_GRAYSCALE_FALLBACK=true
OCR_FALLBACK_MAX_ATTEMPTS=1
OCR_PAGE_TIMEOUT_SECONDS=180
OCR_DOCUMENT_TIMEOUT_SECONDS=3600
OCR_WORKER_STARTUP_TIMEOUT_SECONDS=180
OCR_TERMINATION_GRACE_SECONDS=10
OCR_MAX_WORKER_RESTARTS=2
OCR_WORKER_RECYCLE_AFTER_PAGES=500
OCR_MAX_WORKER_RSS_MB=4096
OCR_SAVE_RENDERED_PAGES=false
OCR_KEEP_FAILED_RENDER=false
OCR_ALLOW_SAVE_RENDERED_IN_PRODUCTION=false
NATIVE_VISIBILITY_PROBE_ENABLED=true
NATIVE_VISIBILITY_MIN_WORDS=8
NATIVE_VISIBILITY_MIN_VISIBLE_WORD_RATIO=0.55
NATIVE_VISIBILITY_MIN_REGION_VARIANCE=4.0
NATIVE_VISIBILITY_MIN_EDGE_DENSITY=0.01
OCR_LAYOUT_MAX_VERTICAL_GAP_RATIO=0.035
OCR_LAYOUT_MIN_HORIZONTAL_OVERLAP_RATIO=0.25
OCR_COLUMN_GAP_RATIO=0.08

# Phase 4.5 — hybrid page routing / throughput / live progress
HYBRID_PAGE_ROUTING_ENABLED=true
EMBEDDED_OCR_VISUAL_AGREEMENT_ENABLED=true
EMBEDDED_OCR_RECOGNITION_CHECK_ENABLED=true
TARGETED_REGION_REPAIR_ENABLED=true
OCR_FAST_PASS_ENABLED=true
OCR_PRIMARY_LIMIT_SIDE_LEN=960
OCR_FALLBACK_LIMIT_SIDE_LEN=1600
FAIR_OCR_SCHEDULING_ENABLED=false
FAIR_OCR_PAGE_CHUNK_SIZE=5
PROGRESS_LIVE_CLOCK_INTERVAL_MS=1000
ETA_MINIMUM_SAMPLE_COUNT=3
ETA_STALE_AFTER_SECONDS=120
PAGE_ROUTING_POLICY_VERSION=phase45-v1

HANDWRITING_CLASSIFIER_PATH=./models/handwriting_classifier/model.onnx

OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3
OPENAI_CONCURRENCY=1
OPENAI_MAX_REGIONS_PER_REQUEST=12
OPENAI_MAX_REGIONS_PER_DOCUMENT=500

LOG_LEVEL=INFO
LOG_DOCUMENT_TEXT=false
