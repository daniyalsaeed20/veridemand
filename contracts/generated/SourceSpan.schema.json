{
  "$defs": {
    "ExtractionMethod": {
      "enum": [
        "native",
        "ocr",
        "manual"
      ],
      "title": "ExtractionMethod",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "context": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "method": {
      "$ref": "#/$defs/ExtractionMethod"
    },
    "page_number": {
      "minimum": 1,
      "title": "Page Number",
      "type": "integer"
    },
    "polygons": {
      "items": {
        "items": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "minItems": 3,
        "type": "array"
      },
      "title": "Polygons",
      "type": "array"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "token_ids": {
      "items": {
        "type": "string"
      },
      "title": "Token Ids",
      "type": "array"
    }
  },
  "required": [
    "id",
    "document_id",
    "page_number",
    "text",
    "polygons",
    "method"
  ],
  "title": "SourceSpan",
  "type": "object"
}
