{
  "$defs": {
    "SessionStatus": {
      "enum": [
        "created",
        "ingesting",
        "processing",
        "reviewing",
        "draftable",
        "draft_review",
        "exportable",
        "expired",
        "failed",
        "deleted"
      ],
      "title": "SessionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "last_activity_at": {
      "format": "date-time",
      "title": "Last Activity At",
      "type": "string"
    },
    "settings": {
      "additionalProperties": true,
      "title": "Settings",
      "type": "object"
    },
    "status": {
      "$ref": "#/$defs/SessionStatus"
    },
    "warning": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Warning"
    }
  },
  "required": [
    "id",
    "created_at",
    "expires_at",
    "last_activity_at",
    "status"
  ],
  "title": "CaseSession",
  "type": "object"
}
