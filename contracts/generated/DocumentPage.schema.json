{
  "$defs": {
    "ExtractionMethod": {
      "enum": [
        "native",
        "ocr",
        "manual"
      ],
      "title": "ExtractionMethod",
      "type": "string"
    },
    "PageRoute": {
      "enum": [
        "native",
        "ocr",
        "manual_review"
      ],
      "title": "PageRoute",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "extraction_method": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtractionMethod"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "height": {
      "exclusiveMinimum": 0,
      "title": "Height",
      "type": "number"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "ocr_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ocr Status"
    },
    "page_number": {
      "minimum": 1,
      "title": "Page Number",
      "type": "integer"
    },
    "quality_flags": {
      "items": {
        "type": "string"
      },
      "title": "Quality Flags",
      "type": "array"
    },
    "route": {
      "$ref": "#/$defs/PageRoute"
    },
    "span_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Span Count"
    },
    "text_coverage": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text Coverage"
    },
    "token_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Token Count"
    },
    "width": {
      "exclusiveMinimum": 0,
      "title": "Width",
      "type": "number"
    }
  },
  "required": [
    "id",
    "document_id",
    "page_number",
    "width",
    "height",
    "route"
  ],
  "title": "DocumentPage",
  "type": "object"
}
