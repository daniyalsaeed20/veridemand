{
  "$defs": {
    "DraftRef": {
      "additionalProperties": false,
      "properties": {
        "paragraph_id": {
          "title": "Paragraph Id",
          "type": "string"
        },
        "sentence_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentence Index"
        }
      },
      "required": [
        "paragraph_id"
      ],
      "title": "DraftRef",
      "type": "object"
    },
    "FindingSeverity": {
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "FindingSeverity",
      "type": "string"
    },
    "StatementSupportLabel": {
      "enum": [
        "supported",
        "partially_supported",
        "unsupported",
        "contradicted",
        "legal_clause",
        "argument"
      ],
      "title": "StatementSupportLabel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blocking": {
      "title": "Blocking",
      "type": "boolean"
    },
    "code": {
      "title": "Code",
      "type": "string"
    },
    "document_ids": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document Ids"
    },
    "draft_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/DraftRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fact_ids": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fact Ids"
    },
    "id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Id"
    },
    "issue_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Issue Id"
    },
    "message": {
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "semantic_label": {
      "anyOf": [
        {
          "$ref": "#/$defs/StatementSupportLabel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "severity": {
      "$ref": "#/$defs/FindingSeverity"
    },
    "source_span_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Span Ids",
      "type": "array"
    }
  },
  "required": [
    "code",
    "severity",
    "blocking",
    "message"
  ],
  "title": "PreflightFinding",
  "type": "object"
}
