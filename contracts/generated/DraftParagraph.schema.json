        "unsupported",
        "contradicted",
        "legal_clause",
        "argument"
      ],
      "title": "StatementSupportLabel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contains_argument": {
      "default": false,
      "title": "Contains Argument",
      "type": "boolean"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "support_label": {
      "anyOf": [
        {
          "$ref": "#/$defs/StatementSupportLabel"
        },
        {
          "type": "null"
        }
