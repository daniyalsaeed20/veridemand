    },
    "supporting_fact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Supporting Fact Ids",
      "type": "array"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "verification_required": {
      "default": false,
      "title": "Verification Required",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "text"
  ],
  "title": "DraftParagraph",
  "type": "object"
}
