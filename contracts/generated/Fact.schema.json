{
  "$defs": {
    "FactStatus": {
      "enum": [
        "suggested",
        "verified",
        "edited",
        "conflicting",
        "needs_review",
        "rejected",
        "locked"
      ],
      "title": "FactStatus",
      "type": "string"
    },
    "UserOverride": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "value",
        "reason",
        "at"
      ],
      "title": "UserOverride",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "criticality": {
      "anyOf": [
        {
          "enum": [
            "critical",
            "normal"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Criticality"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "display_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Display Value"
    },
    "document_ids": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document Ids"
    },
    "extraction_methods": {
      "items": {
        "type": "string"
      },
      "title": "Extraction Methods",
      "type": "array"
    },
    "fact_type": {
      "title": "Fact Type",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "label_context": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label Context"
    },
    "normalized_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Normalized Value"
    },
    "provenance": {
      "anyOf": [
        {
          "enum": [
            "deterministic",
            "calculated",
            "user",
            "llm_optional"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "deterministic",
      "title": "Provenance"
    },
    "raw_value": {
      "title": "Raw Value",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "source_span_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Span Ids",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/FactStatus"
    },
    "user_override": {
      "anyOf": [
        {
          "$ref": "#/$defs/UserOverride"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "session_id",
    "fact_type",
    "raw_value",
    "confidence",
    "status"
  ],
  "title": "Fact",
  "type": "object"
}
