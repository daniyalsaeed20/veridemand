{
  "$defs": {
    "ClassificationStatus": {
      "enum": [
        "proposed",
        "ambiguous",
        "needs_confirmation",
        "user_confirmed"
      ],
      "title": "ClassificationStatus",
      "type": "string"
    },
    "Document": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentClassification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "classification_confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Classification Confidence"
        },
        "classification_conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Classification Conflicts",
          "type": "array"
        },
        "classification_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Classification Reason"
        },
        "classification_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClassificationStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-fA-F]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "exclude_from_drafting": {
          "default": false,
          "title": "Exclude From Drafting",
          "type": "boolean"
        },
        "file_type": {
          "$ref": "#/$defs/DocumentFileType"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "page_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Count"
        },
        "page_quality_warning_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Quality Warning Count"
        },
        "safety_archetype": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafetyArchetype"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sequence_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence Index"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DocumentStatus"
        },
        "treat_as_secondary_evidence": {
          "default": false,
          "title": "Treat As Secondary Evidence",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "session_id",
        "display_name",
        "file_type",
        "content_sha256",
        "status"
      ],
      "title": "Document",
      "type": "object"
    },
    "DocumentClassification": {
      "enum": [
        "police_report",
        "insurer_correspondence",
        "medical_record",
        "imaging_report",
        "bill_ledger",
        "lien",
        "wage_loss",
        "photographs",
        "existing_demand",
        "template",
        "other"
      ],
      "title": "DocumentClassification",
      "type": "string"
    },
    "DocumentFileType": {
      "enum": [
        "pdf",
        "docx",
        "jpg",
        "png",
        "tiff"
      ],
      "title": "DocumentFileType",
      "type": "string"
    },
    "DocumentStatus": {
      "enum": [
        "uploaded",
        "duplicate",
        "rejected",
        "normalized",
        "ready_for_extraction",
        "extracting",
        "extracted",
        "classified",
        "excluded"
      ],
      "title": "DocumentStatus",
      "type": "string"
    },
    "SafetyArchetype": {
      "enum": [
        "none",
        "existing_demand",
        "template",
        "uncertain_derivative"
      ],
      "title": "SafetyArchetype",
      "type": "string"
    },
    "UploadRejection": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "error_code": {
          "title": "Error Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "display_name",
        "error_code",
        "message"
      ],
      "title": "UploadRejection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accepted": {
      "items": {
        "$ref": "#/$defs/Document"
      },
      "title": "Accepted",
      "type": "array"
    },
    "rejected": {
      "items": {
        "$ref": "#/$defs/UploadRejection"
      },
      "title": "Rejected",
      "type": "array"
    }
  },
  "title": "DocumentUploadBatch",
  "type": "object"
}
