htmlcov/

# Node
node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/
*.tsbuildinfo
coverage/

# Runtime / session temp
temp/*
!temp/.gitkeep
temp-e2e/
tmp/
data/sessions/

# Phase 4 local OCR model cache (never commit binaries)
.models/
.paddleocr/

# Phase 5 model-development artefacts (checkpoints, private manifests, caches)
model_development/.artifacts/
model_development/**/__pycache__/
*.pt
*.pth
!backend/tests/fixtures/**/*.pt

# Smoke corpus generator work files (single-page rebuilds; not corpus SoT)
fixtures/synthetic/smoke/_veridemand_fixture_work/

# Spikes (local outputs and venvs)
spikes/**/out/
spikes/**/.venv/

# Local case samples (may contain PII) - keep out of Git
docs/example/*.pdf
docs/example/*.docx
docs/example/*.doc
docs/example/**/*.pdf
docs/example/**/*.docx
docs/example/**/*.doc
docs/example/**/*.tif
docs/example/**/*.tiff
docs/example/**/*.png
docs/example/**/*.jpg
docs/example/**/*.jpeg
docs/example/**/*.webp
docs/example/**/.~lock.*

# Private local regression fixtures (may contain PII) - keep out of Git
fixtures/private/**
!fixtures/private/.gitkeep
!fixtures/private/README.example.md
!fixtures/private/visual-ocr-manifest.local.json.example
!fixtures/private/throughput-corpus.local.json.example
