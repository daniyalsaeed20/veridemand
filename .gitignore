# Environment / secrets
.env
.env.*
!.env.example

# Developer tool installs (not product)
.tools/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/
*.tsbuildinfo
coverage/

# Runtime / session temp
temp/*
!temp/.gitkeep
temp-e2e/
tmp/
data/sessions/

# Spikes (local outputs and venvs)
spikes/**/out/
spikes/**/.venv/

# Local case samples (may contain PII) - keep out of Git
docs/example/*.pdf
docs/example/*.docx
docs/example/*.doc
docs/example/**/*.pdf
docs/example/**/*.docx
docs/example/**/*.doc
docs/example/**/*.tif
docs/example/**/*.tiff
docs/example/**/*.png
docs/example/**/*.jpg
docs/example/**/*.jpeg
docs/example/**/*.webp
docs/example/**/.~lock.*

# Private local regression fixtures (may contain PII) - keep out of Git
fixtures/private/**
!fixtures/private/.gitkeep
!fixtures/private/README.example.md

# Copied from pdfjs-dist/wasm by Vite (dev/build); do not commit binaries
frontend/public/pdfjs-wasm/

# Logs / OS / IDE
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
