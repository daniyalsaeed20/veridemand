# Developer tool installs (not product)
.tools/

# Python
**/__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
.eggs/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
backend/.venv/

# Node
node_modules/
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example

# Spikes (local outputs and venvs)
spikes/**/out/
spikes/**/.venv/

# Runtime / session temp (Phase 1+)
tmp/
temp/
data/sessions/
backend/tmp/
backend/data/

# Local case samples (may contain PII) — keep out of Git
docs/example/*.pdf
docs/example/*.docx
docs/example/**/*.pdf
docs/example/**/*.docx

# LibreOffice lock files under local case folders
docs/example/**/.~lock.*

# Private local regression fixtures (may contain PII) — keep out of Git
fixtures/private/*
!fixtures/private/README.example.md

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Generated local artifacts
*.log
